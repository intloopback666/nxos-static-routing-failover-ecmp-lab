#SW-C

conf t
hostname SW-C
feature interface-vlan
#ip routing

vlan 10
  name USERS_VLAN10

interface Ethernet2/1
  switchport
  switchport mode access
  switchport access vlan 10
  no shutdown

interface Ethernet2/2
  no switchport
  ip address 10.12.14.2/29
  no shutdown

interface Ethernet2/3
  no switchport
  ip address 10.12.16.2/29
  no shutdown

interface Vlan10
  ip address 192.168.10.254/24
  no shutdown

interface loopback0
  ip address 10.1.1.12/32
  no shutdown

end
copy running-config startup-config


track 16 ip route 10.12.16.6/29 reachability
exit
track 14 ip route 10.12.14.4/29 reachability
exit

show track

ip route 0.0.0.0/0 ethernet 2/3 10.12.16.6 track 16
ip route 0.0.0.0/0 ethernet 2/2 10.12.14.4 track 14 2

show ip route


copy running-config startup-config


